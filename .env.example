MODELS=MODELS_PATH_HERE
HF_TOKEN=PUT_YOUR_TOKEN_HERE

# For CUDA
# LLAMA_BACKEND=cuda

# For Vulkan
# LLAMA_BACKEND=vulkan

# llama.cpp version to build (single source of truth for all backends).
# Defaults to a pinned commit with MTP support; override to bump.
# LLAMA_CPP_REF=d2462f8f7ac6d80070a587ffebf6cd73730f4280

# GPU placement: name each card and its llama.cpp device (`llama-server --list-devices`).
# Each config then runs on one card or on all of them; configs on different cards run together.
# Unset: every config uses every card, one model at a time.
# GPUS=r9700:Vulkan0,b50:Vulkan1

# radiance backend (AMD RDNA4 .rad containers): add docker-compose.radiance.yml to COMPOSE_FILE
# (or RADIANCE=1 ./up.sh up) and set the card it runs on plus the host's GPU groups:
#   getent group render | cut -d: -f3; getent group video | cut -d: -f3
# RADIANCE_GPU=r9700
# RENDER_GID=
# VIDEO_GID=

# GPU + LLM exporter on :9835 (docker-compose.metrics.yml): card names by PCI address
# (lspci -D), and the VRAM size for cards whose driver doesn't report it (Intel xe).
# GPU_PCI=r9700:0000:01:00.0,b50:0000:02:00.0
# GPU_VRAM_MIB=b50:16304

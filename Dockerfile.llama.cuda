# Stage 1: Build llama-server
FROM nvidia/cuda:13.1.0-devel-ubuntu24.04 AS builder

RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    libcurl4-openssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
# LLAMA_CPP_REF is the single source of truth for the llama.cpp version across
# all backends — set it in docker-compose.yml / .env, not here. Pinning makes
# builds reproducible AND busts the git-clone layer when the ref changes (a bare
# `git clone` would otherwise stay cached, freezing an old pre-MTP checkout).
ARG LLAMA_CPP_REF
RUN git clone https://github.com/ggml-org/llama.cpp.git . && git checkout "${LLAMA_CPP_REF}"

# Kept Architecture 86 for the target 3090, disabled shared libs, targeted server
RUN cmake -B build \
    -DGGML_CUDA=ON \
    -DGGML_RPC=ON \
    -DCMAKE_CUDA_ARCHITECTURES=86 \
    -DBUILD_SHARED_LIBS=OFF \
    -DCMAKE_BUILD_TYPE=Release \
    && cmake --build build --config Release -j$(nproc) --target llama-server

# Stage 2: Your CUDA runtime + llama-swap binary + custom llama-server
FROM nvidia/cuda:13.1.0-runtime-ubuntu24.04

RUN apt-get update && apt-get install -y \
    libcurl4 \
    libgomp1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/mostlygeek/llama-swap:cuda /app/llama-swap /usr/local/bin/llama-swap
COPY --from=builder /app/build/bin/llama-server /usr/local/bin/llama-server

ENTRYPOINT ["llama-swap"]
